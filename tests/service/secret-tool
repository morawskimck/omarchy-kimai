#!/bin/bash
# Test double for libsecret's secret-tool, used by tests/service: one file
# per server URL under $FAKE_KEYRING instead of the real keyring.
# `touch $FAKE_KEYRING/FAIL` makes every call fail like a locked keyring.
set -euo pipefail
action=$1
shift
[[ $action == store ]] && shift # --label=...
url=${4:-}                      # application omarchy-kimai url <url>
file="$FAKE_KEYRING/$(printf %s "$url" | md5sum | cut -c1-16)"

if [[ -e $FAKE_KEYRING/FAIL ]]; then
  echo "secret-tool: Cannot create an item in a locked collection" >&2
  exit 1
fi

case $action in
  store) cat >"$file" ;;
  lookup) [[ -f $file ]] || exit 1; cat "$file" ;;
  clear) rm -f "$file" ;;
  *) echo "unsupported: $action" >&2; exit 2 ;;
esac
